    { "source": "/lut", "destination": "/lut-converter", "permanent": false }
  ],
  "rewrites": [
    { "source": "/S137devhub/", "destination": "https://s137-dev-hub.vercel.app/" },
    { "source": "/S137devhub/:path*", "destination": "https://s137-dev-hub.vercel.app/:path*" },

    { "source": "/prints", "destination": "/prints.html" },
    { "source": "/returns", "destination": "/returns.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/camera-gear", "destination": "/camera-gear.html" },
    { "source": "/guides", "destination": "/guides/index.html" },
    { "source": "/guides/:slug", "destination": "/guides/:slug.html" },
    { "source": "/heliograph", "destination": "/labs/heliograph/index.html" },
    { "source": "/lut-converter", "destination": "/labs/lut-converter/index.html" },
    { "source": "/bradenbachelortripcalculator", "destination": "/bradenbachelortripcalculator.html" },
    { "source": "/print-success", "destination": "/index.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/print/:slug", "destination": "/print/:slug.html" },

    { "source": "/sets", "destination": "/index.html" },
    { "source": "/sets/:slug", "destination": "/index.html" },

    { "source": "/shop", "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|WhatsApp|LinkedInBot|Pinterest|TelegramBot|SkypeUriPreview|redditbot|Embedly|Iframely|vkShare).*" }], "destination": "/og/shop.html" },
    { "source": "/shop", "destination": "/index.html" },
    { "source": "/shop/profiles", "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|WhatsApp|LinkedInBot|Pinterest|TelegramBot|SkypeUriPreview|redditbot|Embedly|Iframely|vkShare).*" }], "destination": "/og/profiles.html" },
    { "source": "/shop/profiles/:slug", "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|WhatsApp|LinkedInBot|Pinterest|TelegramBot|SkypeUriPreview|redditbot|Embedly|Iframely|vkShare).*" }], "destination": "/og/profiles/:slug.html" },
    { "source": "/shop/presets", "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|WhatsApp|LinkedInBot|Pinterest|TelegramBot|SkypeUriPreview|redditbot|Embedly|Iframely|vkShare).*" }], "destination": "/og/presets.html" },
    { "source": "/shop/presets/:slug", "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|WhatsApp|LinkedInBot|Pinterest|TelegramBot|SkypeUriPreview|redditbot|Embedly|Iframely|vkShare).*" }], "destination": "/og/presets.html" },
    { "source": "/shop/:tab(profiles|presets|downloads)", "destination": "/index.html" },
    { "source": "/shop/:tab(profiles|presets)/:slug", "destination": "/index.html" },

    { "source": "/photos", "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|WhatsApp|LinkedInBot|Pinterest|TelegramBot|SkypeUriPreview|redditbot|Embedly|Iframely|vkShare).*" }], "destination": "/og/photos.html" },
    { "source": "/photos", "destination": "/index.html" },

    { "source": "/book", "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|WhatsApp|LinkedInBot|Pinterest|TelegramBot|SkypeUriPreview|redditbot|Embedly|Iframely|vkShare).*" }], "destination": "/og/book.html" },
    { "source": "/book", "destination": "/index.html" },

    { "source": "/whoami", "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|WhatsApp|LinkedInBot|Pinterest|TelegramBot|SkypeUriPreview|redditbot|Embedly|Iframely|vkShare).*" }], "destination": "/og/whoami.html" },
    { "source": "/whoami", "destination": "/index.html" },

    { "source": "/p", "destination": "/index.html" },
    { "source": "/mr.manager/galleries", "destination": "/gallery-admin.html" },
    { "source": "/mr.manager", "destination": "/index.html" },

    { "source": "/g/:slug", "destination": "/g.html" }
  ],
  "headers": [
    { "source": "/conversations", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ] },
    { "source": "/conversations/:path*", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ] },
    { "source": "/g/:slug*", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, noimageindex" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Cache-Control", "value": "no-store" }
    ] },
    { "source": "/g.html", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ] },
    { "source": "/gallery-admin.html", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ] },
    { "source": "/mr.manager/galleries", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ] }
  ]
}
